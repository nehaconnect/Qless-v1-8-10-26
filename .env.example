# ==============================================================================
# QLess — Environment Configuration Template
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL with SSL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your_minimum_32_character_random_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# Payments (Razorpay Mock/Test Mode for V1 Testing)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key

# Base URL for test scripts (Optional, defaults to http://localhost:3000)
BASE_URL=http://localhost:3000
